// Resource file for Fight the Machine Win32 client

#include "resource.h"
#include <windows.h>

// Application icon (comment out if app.ico doesn't exist)
// IDI_APP_ICON ICON "app.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sp00nz.net"
            VALUE "FileDescription", "Fight the Machine - Kill processes as DOOM monsters"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "fightthemachine"
            VALUE "LegalCopyright", "MIT License"
            VALUE "OriginalFilename", "fightthemachine.exe"
            VALUE "ProductName", "Fight the Machine"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

// Application manifest for modern Windows styling and DPI awareness
1 RT_MANIFEST "app.manifest"
