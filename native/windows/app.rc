// Resource file for Fight the Machine - native Windows build

#include <windows.h>

// Application icon. The lowest-numbered icon resource is the one Explorer and
// the taskbar use, so keep this first.
IDI_ICON1 ICON "app.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "sp00nz.net"
            VALUE "FileDescription", "Fight the Machine - Kill processes as DOOM monsters"
            VALUE "FileVersion", "1.1.0.0"
            VALUE "InternalName", "fightthemachine"
            VALUE "LegalCopyright", "GPL v2 - see LICENSE.txt"
            VALUE "OriginalFilename", "fightthemachine.exe"
            VALUE "ProductName", "Fight the Machine"
            VALUE "ProductVersion", "1.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
