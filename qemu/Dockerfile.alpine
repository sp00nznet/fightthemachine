# Fight the Machine - Alpine Linux VM Image
# Minimal Alpine with X11, VNC, noVNC, and psDoom-ng
#
# This Dockerfile creates a rootfs that gets converted to a QCOW2 VM image

FROM alpine:3.19

LABEL maintainer="Fight the Machine Project"
LABEL description="Alpine Linux rootfs for QEMU VM with psDoom-ng"

# Install base system and init
RUN apk add --no-cache \
    # Init system
    openrc \
    # Network
    dhcpcd \
    # X11 and display
    xvfb-run \
    xorg-server \
    x11vnc \
    openbox \
    xterm \
    # noVNC (install websockify via pip)
    novnc \
    py3-numpy \
    # SDL 1.2 runtime (sdl12-compat provides SDL 1.2 API)
    sdl12-compat \
    sdl_mixer \
    libpng \
    # Process management
    supervisor \
    procps \
    python3 \
    py3-pip \
    # Utilities
    bash \
    curl \
    coreutils \
    util-linux \
    # Build tools (for psdoom-ng, will be cleaned later)
    build-base \
    git \
    autoconf \
    automake \
    libtool \
    pkgconf \
    sdl12-compat-dev \
    sdl_mixer-dev \
    libpng-dev \
    libx11-dev \
    libxext-dev \
    && pip3 install --break-system-packages websockify

# Create game user
RUN adduser -D -s /bin/bash doom && \
    echo "doom:doom" | chpasswd

# Clone and build psdoom-ng
WORKDIR /build
COPY patches/add-sudo-cheat.sh /tmp/add-sudo-cheat.sh
RUN chmod +x /tmp/add-sudo-cheat.sh && \
    git clone --depth 1 https://github.com/orsonteodoro/psdoom-ng.git && \
    /tmp/add-sudo-cheat.sh /build/psdoom-ng/trunk/src/doom/st_stuff.c && \
    cd psdoom-ng/trunk && \
    ./autogen.sh && \
    ./configure --disable-sdlnet && \
    touch src/psdoom-ng.desktop && \
    (make -j$(nproc) -k || true) && \
    (test -f src/psdoom-ng || \
      (cd src && gcc -o psdoom-ng i_main.o i_system.o m_argv.o m_misc.o d_event.o d_iwad.o \
        d_loop.o d_mode.o deh_str.o i_cdmus.o i_endoom.o i_joystick.o i_scale.o i_sound.o \
        i_timer.o i_video.o i_videohr.o m_bbox.o m_cheat.o m_config.o m_controls.o m_fixed.o \
        sha1.o memio.o tables.o v_video.o w_checksum.o w_main.o w_wad.o w_file.o w_file_stdc.o \
        w_file_posix.o w_file_win32.o z_zone.o w_merge.o gusconf.o i_pcsound.o i_sdlsound.o \
        i_sdlmusic.o i_oplmusic.o midifile.o mus2mid.o aes_prng.o \
        deh_io.o deh_main.o deh_mapping.o deh_text.o \
        doom/libdoom.a ../textscreen/libtextscreen.a ../pcsound/libpcsound.a ../opl/libopl.a \
        -lSDL -lSDL_mixer -lpng -lz -lm)) && \
    cp src/psdoom-ng /usr/local/bin/ && \
    chmod +x /usr/local/bin/psdoom-ng

# Copy psDoom WAD files and download DOOM shareware WAD
RUN mkdir -p /usr/share/games/doom
COPY wad/psdoom1.wad wad/psdoom2.wad /usr/share/games/doom/
# Download DOOM shareware WAD (freely distributable)
RUN curl -fsSL -o /usr/share/games/doom/doom1.wad \
    "https://distro.ibiblio.org/slitaz/sources/packages/d/doom1.wad" && \
    cp /usr/share/games/doom/doom1.wad /usr/share/games/doom/DOOM1.WAD && \
    cp /usr/share/games/doom/doom1.wad /usr/share/games/doom/DOOM.WAD

# Clean up build dependencies to reduce size
RUN apk del \
    build-base git autoconf automake libtool pkgconf \
    sdl12-compat-dev sdl_mixer-dev libpng-dev libx11-dev libxext-dev && \
    rm -rf /build /root/.cache /tmp/* /var/cache/apk/*

# Create directories
RUN mkdir -p /var/log/supervisor /var/run /home/doom/.config/openbox /etc/supervisor/conf.d

# Copy configuration files
COPY docker/supervisord.conf /etc/supervisor/conf.d/supervisord.conf
COPY docker/process-respawner.py /usr/local/bin/process-respawner.py
COPY docker/openbox-rc.xml /home/doom/.config/openbox/rc.xml
COPY qemu/vm-init.sh /etc/local.d/vm-init.start

# Make scripts executable
RUN chmod +x /usr/local/bin/process-respawner.py /etc/local.d/vm-init.start && \
    chown -R doom:doom /home/doom/.config

# Configure services to start on boot
RUN rc-update add local default && \
    rc-update add dhcpcd default

# Create noVNC index redirect
RUN mkdir -p /usr/share/novnc && \
    echo '<!DOCTYPE html><html><head><meta http-equiv="refresh" content="0;url=vnc.html?autoconnect=true&resize=scale"></head></html>' > /usr/share/novnc/index.html

# Set environment
ENV DISPLAY=:0
ENV RESOLUTION=1024x768
ENV HOME=/home/doom

# Create fstab
RUN echo "LABEL=fightthemachine / ext4 defaults,noatime 0 1" > /etc/fstab && \
    echo "proc /proc proc defaults 0 0" >> /etc/fstab && \
    echo "sysfs /sys sysfs defaults 0 0" >> /etc/fstab && \
    echo "devtmpfs /dev devtmpfs defaults 0 0" >> /etc/fstab

# Configure inittab for autologin and service start
RUN sed -i 's|^tty1::respawn:/sbin/getty.*|tty1::respawn:/bin/login -f root|' /etc/inittab && \
    echo "::sysinit:/etc/local.d/vm-init.start" >> /etc/inittab

# The container's filesystem will be exported as the VM rootfs
CMD ["/bin/sh"]
